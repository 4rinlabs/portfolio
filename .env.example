# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/4rinlabs?schema=public"

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="https://www.4rinlabs.com"

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="4RinLabs <noreply@4rinlabs.com>"
CONTACT_NOTIFY_EMAIL="4rinlabs@gmail.com"

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.4rinlabs.com"

# ─── Admin seed credentials ───────────────────────────────────────────────────
ADMIN_EMAIL="admin@4rinlabs.com"
ADMIN_PASSWORD="change-me-in-production"
