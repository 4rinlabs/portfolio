# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/4rinlabs?schema=public"

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="https://www.4rinlabs.com"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="4RinLabs <hello@4rinlabs.com>"
CONTACT_NOTIFY_EMAIL="4rinlabs@gmail.com"

# ─── Cloudflare Turnstile (Bot Protection) ─────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ─── Vercel Cron (Maintenance & Rate-Limit Cleanup) ───────────────────────────
CRON_SECRET="your-cron-secret-here-generate-with-openssl-rand-base64-32"

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.4rinlabs.com"

# ─── Admin seed credentials ───────────────────────────────────────────────────
ADMIN_EMAIL="admin@4rinlabs.com"
ADMIN_PASSWORD="change-me-in-production"
